# General App Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=generate-a-32-byte-secure-random-secret-key
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_life_os
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
DENYS_TELEGRAM_ID=123456789
OLEKSANDRA_TELEGRAM_ID=987654321
FAMILY_GROUP_CHAT_ID=-100123456789

# AI & LLM Providers
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_IF_USING_OPENAI
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=60
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_MAX_BYTES=20971520

# Oura Ring OAuth2 Credentials
OURA_CLIENT_ID=YOUR_OURA_DEVELOPER_CLIENT_ID
OURA_CLIENT_SECRET=YOUR_OURA_DEVELOPER_CLIENT_SECRET
OURA_REDIRECT_URI=https://family.example.com/oauth/oura/callback
OURA_SCOPES=daily heartrate spo2
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Google Sheets Sync Integration
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_CREDENTIALS_JSON_PATH=./google_credentials.json
GOOGLE_CREDENTIALS_JSON=
# Prefer a named tab when the spreadsheet has multiple worksheets, e.g. Расходы!A:I
GOOGLE_SHEETS_RANGE=A:I
# Keep "ledger" for the original append-only transaction log. The opt-in
# monthly_budget layout writes only UAH expenses for this exact month into the
# configured day/category grid and uses a hidden receipt tab for idempotency.
GOOGLE_SHEETS_LAYOUT=ledger
# Required only when GOOGLE_SHEETS_LAYOUT=monthly_budget, e.g. 2026-08
GOOGLE_SHEETS_PERIOD=
# The linked template uses gid=0 for the visible monthly grid.
GOOGLE_SHEETS_MONTHLY_SHEET_ID=0

# Shared family-chat memory and proactive summaries
SHARED_CHAT_MEMORY_ENABLED=true
CHAT_SUMMARY_IDLE_MINUTES=30
CHAT_SUMMARY_POLL_SECONDS=30
CHAT_SUMMARY_DAILY_HOUR=21
CHAT_SUMMARY_MAX_MESSAGES=100

# Personal Gmail and Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Object Storage (S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=family-life-os-docs
