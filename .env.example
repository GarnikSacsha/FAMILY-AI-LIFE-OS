# General App Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=generate-a-32-byte-secure-random-secret-key

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_life_os
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
DENYS_TELEGRAM_ID=123456789
OLEKSANDRA_TELEGRAM_ID=987654321
FAMILY_GROUP_CHAT_ID=-100123456789

# AI & LLM Providers
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_IF_USING_OPENAI

# Oura Ring OAuth2 Credentials
OURA_CLIENT_ID=YOUR_OURA_DEVELOPER_CLIENT_ID
OURA_CLIENT_SECRET=YOUR_OURA_DEVELOPER_CLIENT_SECRET
OURA_REDIRECT_URI=http://localhost:8080/oura/callback

# Google Sheets Sync Integration
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_CREDENTIALS_JSON_PATH=./google_credentials.json

# Object Storage (S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=family-life-os-docs
